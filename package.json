{
  "name": "@payperbyte/sdk",
  "version": "0.1.4",
  "type": "commonjs",
  "description": "PayPerByte TypeScript SDK for the BYTE Library — cryptographically attested, provenance-verifiable data for AI agents (proves who signed the exact bytes, not data correctness). No token; direct-allowance USDC settlement on Arbitrum.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "abis"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "viem": "^2.20.0"
  },
  "peerDependencies": {
    "@x402/core": "^2.13.0",
    "@x402/evm": "^2.13.0"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": true
    },
    "@x402/evm": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "byte",
    "ai-agents",
    "attested-data",
    "provenance",
    "x402",
    "usdc",
    "arbitrum"
  ],
  "homepage": "https://payperbyte.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0rkz/ppb-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/0rkz/ppb-sdk/issues"
  },
  "author": "0rkz (https://github.com/0rkz)",
